# Google Ads MCP server configuration.
#
# Copy to .env and fill in. Never commit the completed file.

# --- Required credentials ---------------------------------------------------

# From the Google Ads API Center on your MANAGER account.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth client credentials. Create a "Desktop app" OAuth client in a Google Cloud
# project with the Google Ads API enabled.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Long-lived refresh token with the https://www.googleapis.com/auth/adwords scope.
# Mint one with:  npm run get-refresh-token
GOOGLE_ADS_REFRESH_TOKEN=

# The MANAGER account that the developer token belongs to, without dashes.
# This is sent as the login-customer-id header on every request.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Optional ---------------------------------------------------------------

# Google Ads API major version. Defaults to v25.
# GOOGLE_ADS_API_VERSION=v25

# Emergency kill switch. When false, no mutation tool is registered at all and the
# server exposes read-only tools. Read tools keep working either way.
# GOOGLE_ADS_MUTATIONS_ENABLED=true

# Path to the capability configuration YAML. Defaults to the file shipped with the
# server at dist/capabilities/default-config.yaml.
# GOOGLE_ADS_MCP_CONFIG=/absolute/path/to/capabilities.yaml

# fatal | error | warn | info | debug | trace. Logs are written to stderr only.
# LOG_LEVEL=info
