# Copy to .env and replace placeholders. Never commit the completed file.
# A complete mode-free user setup remains supported; user mode requires a manager ID.
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Optional in either mode. Developer tokens are deprecated.
# GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
# GOOGLE_ADS_AUTH_MODE=user

# For service-account mode, remove the three user OAuth settings above, select one
# source below, and optionally keep the manager ID for manager routing.
# GOOGLE_ADS_AUTH_MODE=service_account
# GOOGLE_ADS_SERVICE_ACCOUNT_SOURCE=file
# GOOGLE_ADS_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/key.json
# Or select inline JSON instead of file (never supply both):
# GOOGLE_ADS_SERVICE_ACCOUNT_SOURCE=json
# GOOGLE_ADS_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","client_email":"placeholder@example.iam.gserviceaccount.com","private_key":"PLACEHOLDER"}
# Or select service-account ADC, including service-account impersonation:
# GOOGLE_ADS_SERVICE_ACCOUNT_SOURCE=adc
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/adc.json
# Explicit GOOGLE_APPLICATION_CREDENTIALS applies only to selected ADC.
# Ambient ADC files or attached service accounts are discovered automatically.

# GOOGLE_ADS_API_VERSION=v25
# GOOGLE_ADS_MUTATIONS_ENABLED=true
# GOOGLE_ADS_MCP_CONFIG=/absolute/path/to/capabilities.local.yaml
# LOG_LEVEL=info

# AgentApps install settings (replace the example ID; do not use it unchanged).
# GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=9876543210
# GOOGLE_ADS_INSTALL_MODE=read_only
# Mutation mode additionally requires an explicit positive configured-daily-budget ceiling:
# GOOGLE_ADS_INSTALL_MODE=mutations
# GOOGLE_ADS_MASTER_BUDGET_MICROS=500000000
# Optional YAML or JSON policy can only narrow customer scope, actions, and limits.
# GOOGLE_ADS_CAPABILITIES_INLINE={"version":1,"accounts":{"allowedCustomerIds":["9876543210"]},"mutations":{"enabled":false,"default":"deny","tools":{}}}
# For AgentApps, use GOOGLE_ADS_AUTH_MODE=service_account,
# GOOGLE_ADS_SERVICE_ACCOUNT_SOURCE=json, and GOOGLE_ADS_SERVICE_ACCOUNT_KEY_JSON above.
# OAuth settings above remain compatible; a developer token is optional.
